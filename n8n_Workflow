    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const visitDate = $input.item.json.visitDate;\nconst timeline = $input.item.json.timeline || [];\n\nif (!visitDate) {\n  return null;\n}\n\n// Check if reminder email already sent\nconst emailAlreadySent = timeline.some(event => event.action === \"Reminder email sent\");\nif (emailAlreadySent) {\n  return null;\n}\n\nconst visit = new Date(visitDate);\nconst now = new Date();\n\n// Calculate time difference in hours\nconst hoursDiff = (visit - now) / (1000 * 60 * 60);\n\n// Send email if visit is within 48 hours (2 days) from now\nif (hoursDiff > 0 && hoursDiff <= 48) {\n  return $input.item;\n}\n\nreturn null;"
      },
